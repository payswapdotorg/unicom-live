// UNiCOM Console — persistence spine (R-C1, BACKEND-1).
//
// Conventions (operator-approved R-C1 contract):
//   - ids are plain strings assigned by the API layer (seed ids like
//     "halcyon"/"m-1", runtime ids like `m-<ts>`); no cuid defaults.
//   - array-shaped data rides in JSON string columns (SQLite has no list
//     primitives) — parse with the safe helpers in src/lib/product/api-helpers.
//   - display strings (humanized time, eta, lastSync) are stored as-rendered;
//     the UI contract (src/lib/product/data.ts) is the source of truth.
//   - the frozen 14-model WAVE-1 contract above was replaced wholesale by the
//     R-C1 8-model spine; db:push is destructive by design (fresh boot state).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- stores & connections ----------

model Store {
  id             String   @id
  name           String
  domain         String
  platform       String // shopify | woocommerce | etsy | amazon | squarespace | bigcommerce
  health         String // healthy | attention | syncing
  products       Int
  orders7d       Int
  revenue7d      Float // USD
  delta7d        Float // % vs previous week
  lastSync       String // humanized
  installedSkills String  @default("[]") // JSON string[] — skill ids
  apiUsage       Int      @default(0) // 0-100
  createdAt      DateTime @default(now())
}

// ---------- missions (multi-lane orchestrated work) ----------

model Mission {
  id        String   @id
  title     String
  brief     String
  stores    String   @default("[]") // JSON string[] — store ids
  status    String // running | in-review | awaiting-approval | done
  eta       String
  started   String // "HH:MMZ" or humanized
  groupId   String? // project group id — null when ungrouped
  createdAt DateTime @default(now())
  lanes     Lane[]
}

model Lane {
  id        String  @id
  missionId String
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  name      String
  worker    String // wkr-xx
  status    String // running | in-review | done
  progress  Int // 0-100
  evidence  String  @default("[]") // JSON string[] — evidence chips
}

// ---------- decisions (the approval gate) ----------

model Decision {
  id         String    @id
  kind       String // price | listing | refund | campaign
  title      String
  storeId    String // store id (no FK — decisions may outlive re-connects)
  proposedBy String // skill/agent name shown in the UI
  risk       String // low | medium | high
  impact     String // one-line expected impact
  evidence   String    @default("[]") // JSON string[] — evidence chips
  detail     String    @default("[]") // JSON {label,value}[] — the review table
  diffs      String? // JSON DiffBlock[] or null — evidence-first review
  diffNote   String?
  expires    String // humanized expiry
  resolved   Boolean   @default(false)
  verdict    String? // approved | declined — set on resolve
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
}

// ---------- watch ring ----------

model WatchEvent {
  id        String   @id
  ts        String // "HH:MMZ" UTC
  kind      String // heartbeat | anomaly | heal | review | dispatch
  actor     String // skill/agent id or "you"
  text      String
  createdAt DateTime @default(now())
}

// ---------- skills (pluggable capability packs) ----------

model Skill {
  id          String @id // slug, e.g. "price-sentinel"
  name        String
  glyph       String
  blurb       String // UI: tagline
  watches     String
  acts        String
  events      Int // UI: events7d
  risk        String // read-only | acts-with-approval | autonomous
  installedOn String @default("[]") // JSON string[] — store ids
}

// ---------- settings (singleton row) ----------

model Setting {
  id   String @id // "singleton"
  data String // full SettingsState JSON
}

// ---------- commander (chat) ----------

model ChatMessage {
  id        String   @id
  role      String // merchant | agent
  text      String
  plan      String? // JSON string[] or null
  createdAt DateTime @default(now())
}
